{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matrixscroll.com/schemas/ledger-epoch.v1.json",
  "title": "Matrix Scroll ledger epoch checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "epoch_id",
    "start_index",
    "end_index",
    "tip_hash",
    "root_hash",
    "record_count",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "matrixscroll.ledger_epoch.v1" },
    "epoch_id": { "type": "string", "minLength": 1 },
    "start_index": { "type": "integer", "minimum": 0 },
    "end_index": { "type": "integer", "minimum": 0 },
    "tip_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "root_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "record_count": { "type": "integer", "minimum": 1 },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "signature": { "type": "object" },
    "pqc_signatures": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
